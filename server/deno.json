{
	"name": "@j0code/shortlink-server",
	"version": "0.0.1",
	"exports": {},
	"tasks": {
		"dev": "deno run --watch --allow-net --allow-read --allow-write --allow-env --allow-sys=uid --allow-run=/bin/sh --allow-sys=cpus,networkInterfaces,hostname --allow-ffi main.ts",
		"db": "sqlite3 -box ./storage/shortlinks.db"
	},
	"imports": {
		"@felix/argon2": "jsr:@felix/argon2@^3.0.6",
		"@j0code/yson": "jsr:@j0code/yson@^1.2.6",
		"@std/assert": "jsr:@std/assert@1",
		"@std/encoding": "jsr:@std/encoding@^1.0.11",
		"@std/http": "jsr:@std/http@^1.1.3",
		"@types/better-sqlite3": "npm:@types/better-sqlite3@^9.6.0",
		"@types/express": "npm:@types/express@^5.0.6",
		"@valibot/valibot": "jsr:@valibot/valibot@^1.4.2",
		"better-sqlite3": "npm:better-sqlite3@^13.0.3",
		"express": "npm:express@^5.2.1"
	}
}
